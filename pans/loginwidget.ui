  <property name="styleSheet">
   <string notr="true">QWidget#LoginWidget {
    background-color: #f5f9fe;
}
QFrame#leftPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #eaf5fe, stop:1 #cde5f8);
}
QFrame#rightPanel {
    background-color: #ffffff;
}
#titleLabel {
    color: #1a3e60;
    font-size: 24px;
    font-weight: 700;
}
#subtitleLabel {
    color: #7b98b5;
    font-size: 13px;
}
#tabPhoneButton, #tabInsuranceButton {
    background: transparent;
    border: none;
    color: #5a7a9a;
    font-size: 15px;
    padding: 8px 12px;
    border-bottom: 2px solid transparent;
}
#tabPhoneButton:checked, #tabInsuranceButton:checked {
    color: #2f80ed;
    border-bottom: 2px solid #2f80ed;
    font-weight: 600;
}
QLineEdit {
    background-color: #f7fafc;
    border: 1px solid #cde3f0;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
    color: #1a3e60;
}
QLineEdit:focus {
    border: 1px solid #2f80ed;
    background-color: #ffffff;
}
#loginButton {
    background-color: #2f80ed;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 12px;
    font-size: 16px;
    font-weight: 600;
}
#loginButton:hover {
    background-color: #1c6fd6;
}
#loginButton:pressed {
    background-color: #155ab5;
}
#getSmsButton {
    background-color: #e8f1fc;
    color: #2f80ed;
    border: 1px solid #b8d8f0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}
#getSmsButton:hover {
    background-color: #d5e7fa;
}
#captchaImageLabel {
    background-color: #e0ecf5;
    color: #1a3e60;
    border: 1px solid #cde3f0;
    border-radius: 4px;
    font-size: 14px;
}
#rememberCheckBox {
    color: #5a7a9a;
    font-size: 13px;
}
#forgotButton {
    background: transparent;
    border: none;
    color: #2f80ed;
    font-size: 13px;
}
#leftTitle {
    color: #1a3e60;
    font-size: 26px;
    font-weight: 700;
}
#leftSubtitle {
    color: #3c6e9c;
    font-size: 14px;
}
#leftFooter {
    color: #6b8fae;
    font-size: 12px;
}
#logoLabel {
    background-color: #ffffff;
    color: #2f80ed;
    border-radius: 40px;
    font-size: 28px;
    font-weight: 700;
    border: 2px solid #ffffff;
}</string>
